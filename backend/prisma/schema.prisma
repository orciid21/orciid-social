generator client {
  provider = "prisma-client-js"
  // NOTE: tried engineType="binary" to dodge "timer has gone away" — it did NOT
  // help: the panic lives in the engine's Rust `futures-timer` crate (used by
  // BOTH engines) and fires when Hostinger's shared host throttles CPU. The
  // binary engine made it worse (subprocess exits 101 → requests HANG instead of
  // failing fast). Back to the default library engine: it at least fails fast
  // with 500 so verifyDatabaseInBackground can recycle, and was stable for days
  // before a burst of rapid redeploys. The real mitigation is NOT churning
  // redeploys (each restart under load re-triggers the panic).
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  password      String
  avatar        String?
  role          Role      @default(USER)
  isVerified    Boolean   @default(false)
  verifyToken   String?
  resetToken    String?
  resetTokenExp DateTime?
  fbConnectToken String?  @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  subscription    Subscription?
  socialAccounts  SocialAccount[]
  posts           Post[]
  workspaces      WorkspaceMember[]
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  plan                 Plan               @default(FREE)
  status               SubscriptionStatus @default(TRIALING)
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model Workspace {
  id        String            @id @default(uuid())
  name      String
  slug      String            @unique
  logo      String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  members     WorkspaceMember[]
  accounts    SocialAccount[]
  projects    Project[]
  posts       Post[]
  invitations Invitation[]
}

// A Project is a client or brand inside a workspace: its own set of connected
// channels, so an agency running several brands can't accidentally publish one
// brand's post to another. The team (WorkspaceMember) stays shared across all
// projects — you invite a colleague once, not once per client.
model Project {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accounts  SocialAccount[]

  @@unique([workspaceId, name])
}

// Pending team invitations. When the invited email belongs to an existing user
// we add them straight to WorkspaceMember; otherwise we keep a PENDING row here
// and convert it to a membership when that email registers (see auth register).
model Invitation {
  id          String    @id @default(uuid())
  workspaceId String
  email       String
  role        WsRole    @default(MEMBER)
  token       String    @unique @default(uuid())
  status      String    @default("PENDING")
  invitedBy   String?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  userId      String
  workspaceId String
  role        WsRole    @default(MEMBER)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, workspaceId])
}

model SocialAccount {
  id           String         @id @default(uuid())
  userId       String
  workspaceId  String?
  projectId    String?
  platform     Platform
  platformId   String
  name         String
  username     String?
  avatar       String?
  accessToken  String         @db.Text
  refreshToken String?        @db.Text
  tokenExpiry  DateTime?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  posts     PostAccount[]

  @@unique([userId, platform, platformId])

  // projectId is declared as a relation here, but in production the column was
  // added by raw ALTER TABLE (see PENDING_COLUMNS) with no FOREIGN KEY, so InnoDB
  // never created the index a relation would normally bring. That left the
  // projects sidebar — which loads on every page — scanning the whole table.
  // ensureIndexes() checks the live schema and skips this if an index does exist.
  @@index([projectId])
}

model Post {
  id          String      @id @default(uuid())
  userId      String
  workspaceId String?
  content     String      @db.Text
  mediaUrls   Json        @default("[]")
  status      PostStatus  @default(DRAFT)
  scheduledAt DateTime?
  publishedAt DateTime?
  failReason  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  accounts  PostAccount[]
  analytics PostAnalytics[]

  // Post carries no unique constraint, so before these every dashboard count ran
  // off the bare userId foreign-key index and then filtered status row by row —
  // i.e. it touched every post the user had ever written.
  @@index([userId, status, publishedAt])
  // status leads for two different readers: the approval queue (a count + an
  // ORDER BY createdAt take:3, both on every dashboard mount) and the boot-time
  // scheduler reload, which selects every SCHEDULED post with no limit.
  @@index([status, createdAt])
  // The calendar is the best-shaped query in the app: equality on userId, range
  // on scheduledAt, and a sort on that same column — one index scan serves all
  // three. It has no take, so a busy month is hundreds of rows filesorted today.
  @@index([userId, scheduledAt])
}

model PostAccount {
  id              String        @id @default(uuid())
  postId          String
  socialAccountId String
  status          PostStatus    @default(DRAFT)
  platformPostId  String?
  failReason      String?
  publishedAt     DateTime?

  post          Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([postId, socialAccountId])

  // The 6-hourly engagement collector is the only query in the codebase with no
  // tenant scoping — it sweeps this table across every customer. The unique above
  // cannot help it (neither column is filtered), so it is a full scan plus a
  // filesort today, and take:60 bounds the rows RETURNED, not the rows examined.
  @@index([status, publishedAt])
}

model PostAnalytics {
  id        String   @id @default(uuid())
  postId    String
  platform  Platform
  likes     Int      @default(0)
  comments  Int      @default(0)
  shares    Int      @default(0)
  reach     Int      @default(0)
  clicks    Int      @default(0)
  impressions Int    @default(0)
  fetchedAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  // The highest-value index here. This table is append-only and never pruned, and
  // five per-request dashboard queries share one shape: postId (through a
  // post.userId subquery) plus a fetchedAt range. postId is the equality column,
  // fetchedAt the range — and the prefix still serves the postId-only loads.
  @@index([postId, fetchedAt])
}

enum Role {
  USER
  ADMIN
}

enum WsRole {
  OWNER
  ADMIN
  MEMBER
}

enum Plan {
  FREE
  STARTER
  PRO
  AGENCY
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum Platform {
  FACEBOOK
  INSTAGRAM
  TWITTER
  LINKEDIN
  TIKTOK
  THREADS
  YOUTUBE
  PINTEREST
}

enum PostStatus {
  DRAFT
  PENDING_APPROVAL
  SCHEDULED
  PUBLISHED
  FAILED
  CANCELED
}
